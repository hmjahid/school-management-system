# Eskoofy Node.js variant — environment
# Copy to `.env` and fill in. Never commit real secrets.

# --- App ---
NODE_ENV=development
APP_NAME="Eskoofy"
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC

# Variant profile: bd | int  (build-time profile — never branch on this in feature code)
ESKOOFY_VARIANT=int
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database (same schema as the Laravel app) ---
# Local dev: the shared esk-mariadb container (host port 3307), dedicated DB.
DATABASE_URL="mysql://esk:eskpw@127.0.0.1:3307/eskoofy_node"
# Or any MySQL/MariaDB, e.g.:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/eskoofy"

# --- Session / auth ---
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE=eskoofy_session
SESSION_TTL_HOURS=24

# --- Variant feature flags (mirrors build/profiles/profiles.php) ---
ESKOOFY_MINISTRY_LINKS=false
ESKOOFY_MINISTRY_BADGE=false
PAYMENT_CURRENCY=USD
SMS_DRIVER=log
