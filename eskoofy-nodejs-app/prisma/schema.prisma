  fee_payments_fee_payments_approved_byTousers      fee_payments[]               @relation("fee_payments_approved_byTousers")
  fee_payments_fee_payments_created_byTousers       fee_payments[]               @relation("fee_payments_created_byTousers")
  fees                                              fees[]
  guardians                                         guardians[]
  leave_requests                                    leave_requests[]
  ledger_entries                                    ledger_entries[]
  messages_messages_receiver_idTousers              messages[]                   @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers                messages[]                   @relation("messages_sender_idTousers")
  notices                                           notices[]
  notification_preferences                          notification_preferences[]
  payments_payments_updated_byTousers               payments[]                   @relation("payments_updated_byTousers")
  payments_payments_created_byTousers               payments[]                   @relation("payments_created_byTousers")
  recurring_payment_profiles                        recurring_payment_profiles[]
  refresh_tokens                                    refresh_tokens[]
  refunds_refunds_processed_byTousers               refunds[]                    @relation("refunds_processed_byTousers")
  refunds_refunds_user_idTousers                    refunds[]                    @relation("refunds_user_idTousers")
  scheduled_notifications                           scheduled_notifications[]
  sections                                          sections[]
  sms_campaigns                                     sms_campaigns[]
  staff_attendances                                 staff_attendances[]
  student_id_cards                                  student_id_cards[]
  students                                          students[]
  teachers                                          teachers[]
  testimonials                                      testimonials[]
  user_widget_preferences                           user_widget_preferences[]
  roles                                             roles                        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  visitor_logs                                      visitor_logs[]

  @@unique([phone, role_id], map: "users_phone_role_unique")
  @@unique([email, role_id], map: "users_email_role_unique")
  @@index([role], map: "users_role_index")
}

model vehicles {
  id               Int                       @id @default(autoincrement())
  number           String                    @unique(map: "vehicles_number_unique")
  type             String?
  capacity         Int                       @default(0)
  driver_name      String?
  driver_phone     String?
  is_active        Boolean @default(true)
  created_at       DateTime?
  updated_at       DateTime?
  transport_routes transport_routes[]
}

model visitor_logs {
  id         Int       @id @default(autoincrement())
  ip         String
  url        String
  method     String
  user_agent String?
  referer    String?
  user_id    Int?
  created_at DateTime?
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([ip], map: "visitor_logs_ip_index")
  @@index([created_at], map: "visitor_logs_created_at_index")
}

model website_contents {
  id                  Int                       @id @default(autoincrement())
  created_at          DateTime?
  updated_at          DateTime?
  page                String                    @unique(map: "website_contents_page_unique")
  title               String?
  content             String?
  meta_description    String?
  meta_keywords       String?
  images              String?
  is_active           Boolean @default(true)
  settings            String?
  title_en            String?
  title_bn            String?
  meta_description_en String?
  meta_description_bn String?
  content_en          String?
  content_bn          String?
  cms_input_mode      String                    @default("json")
}

model website_documents {
  id           Int                       @id @default(autoincrement())
  title        String
  category     String?
  file_path    String
  mime_type    String?
  file_size    Int?
  is_published Boolean @default(true)
  created_at   DateTime?
  updated_at   DateTime?

  @@index([category, is_published], map: "website_documents_category_is_published_index")
}

model website_media {
  id         Int       @id @default(autoincrement())
  title      String?
  category   String?
  file_path  String
  mime_type  String?
  file_size  Int?
  created_at DateTime?
  updated_at DateTime?

  @@index([category, created_at], map: "website_media_category_created_at_index")
}

