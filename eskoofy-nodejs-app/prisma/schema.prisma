// Eskoofy Node.js variant — Prisma schema.
//
// Full port of the Laravel reference product's schema
// (`eskoofy-laravel-app/database/migrations`, applied) — 100+ tables, same table
// and column names as the app, introspected then pinned to MySQL.
//
// GOTCHAS carried over from the app (do NOT "clean up"):
//   * Two class tables on purpose: `classes` (legacy) and `school_classes`.
//   * `exams` uses batch_id + academic_session_id + section_id — no class_id/year.
//   * `exam_results` uses obtained_marks (not marks_obtained); total marks live on
//     the exam, not the result.
//   * `students.class_id` FKs `school_classes`; results connect via batch_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model about_contents {
  id               Int       @id @default(autoincrement())
  school_name      String
  tagline          String?
  logo_path        String?
  favicon_path     String?
  established_year Int
  about_summary    String
  mission          String?
  vision           String?
  history          String?
  core_values      String?
  contact_info     String?
  social_links     String?
  address          String
  phone            String
  email            String
  website          String?
  created_at       DateTime?
  updated_at       DateTime?
}

model academic_sessions {
  id                    Int                       @id @default(autoincrement())
  name                  String                    @unique(map: "academic_sessions_name_unique")
  code                  String                    @unique(map: "academic_sessions_code_unique")
  start_date            DateTime
  end_date              DateTime
  description           String?
  is_active             Boolean @default(false)
  is_current            Boolean @default(false)
  status                String                    @default("upcoming")
  metadata              String?
  created_at            DateTime?
  updated_at            DateTime?
  deleted_at            DateTime?
  admissions            admissions[]
  attendances           attendances[]
  batches               batches[]
  class_subject_teacher class_subject_teacher[]
  class_teacher         class_teacher[]
  exams                 exams[]
  routines              routines[]
  school_classes        school_classes[]
  section_teacher       section_teacher[]
}

model academic_years {
  id          Int                       @id @default(autoincrement())
  name        String
  session     String                    @unique(map: "academic_years_session_unique")
  start_date  DateTime
  end_date    DateTime
  is_current  Boolean @default(false)
  description String?
  created_at  DateTime?
  updated_at  DateTime?
  deleted_at  DateTime?
  sections    sections[]
}

model activities {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  message    String
  icon       String?
  color      String    @default("primary")
  properties String?
  read_at    DateTime?
  created_at DateTime?
  updated_at DateTime?
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model activity_log {
  id           Int       @id @default(autoincrement())
  log_name     String?
  description  String
  subject_type String?
  subject_id   Int?
  causer_type  String?
  causer_id    Int?
  properties   String?
  created_at   DateTime?
  updated_at   DateTime?
  event        String?
  batch_uuid   String?

  @@index([log_name], map: "activity_log_log_name_index")
  @@index([causer_type, causer_id], map: "causer")
  @@index([subject_type, subject_id], map: "subject")
}

model admission_documents {
  id           Int                       @id @default(autoincrement())
  admission_id Int
  type         String
  name         String
  file_path    String
  file_type    String
  file_size    Int
  description  String?
  is_approved  Boolean @default(false)
  review_notes String?
  reviewed_by  Int?
  reviewed_at  DateTime?
  created_at   DateTime?
  updated_at   DateTime?
  users        users?                    @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction)
  admissions   admissions                @relation(fields: [admission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admission_id, type, is_approved], map: "admission_documents_admission_id_type_is_approved_index")
}

model admission_settings {
  id                      Int                       @id @default(autoincrement())
  is_open                 Boolean @default(true)
  closed_message_en       String?
  closed_message_bn       String?
  created_at              DateTime?
  updated_at              DateTime?
  admission_fee           Decimal                   @default(0)
  payment_number          String?
  payment_instructions_en String?
  payment_instructions_bn String?
  notice_en               String?
  notice_bn               String?
  display_year            String?
  bar_title_en            String?
  bar_title_bn            String?
}

model admission_tests {
  id                                      Int        @id @default(autoincrement())
  admission_id                            Int
  scheduled_at                            DateTime?
  venue                                   String?
  status                                  String     @default("scheduled")
  notes                                   String?
  created_by                              Int?
  updated_by                              Int?
  created_at                              DateTime?
  updated_at                              DateTime?
  users_admission_tests_updated_byTousers users?     @relation("admission_tests_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  users_admission_tests_created_byTousers users?     @relation("admission_tests_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  admissions                              admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admission_id, scheduled_at, status], map: "admission_tests_admission_id_scheduled_at_status_index")
}

model admissions {
  id                                  Int                   @id @default(autoincrement())
  application_number                  String                @unique(map: "admissions_application_number_unique")
  academic_session_id                 Int
  batch_id                            Int
  first_name                          String
  last_name                           String
  gender                              String
  date_of_birth                       DateTime
  blood_group                         String?
  religion                            String?
  nationality                         String                @default("Bangladeshi")
  photo                               String?
  email                               String                @unique(map: "admissions_email_unique")
  phone                               String
  address                             String
  city                                String
  state                               String?
  country                             String                @default("Bangladesh")
  postal_code                         String
  father_name                         String
  father_phone                        String
  father_occupation                   String?
  mother_name                         String
  mother_phone                        String
  mother_occupation                   String?
  guardian_name                       String?
  guardian_relation                   String?
  guardian_phone                      String?
  previous_school                     String?
  previous_class                      String?
  previous_grade                      String?
  transfer_certificate                String?
  birth_certificate                   String?
  other_documents                     String?
  status                              String                @default("draft")
  rejection_reason                    String?
  admission_date                      DateTime?
  admission_notes                     String?
  submitted_at                        DateTime?
  approved_at                         DateTime?
  rejected_at                         DateTime?
  enrolled_at                         DateTime?
  cancelled_at                        DateTime?
  created_by                          Int?
  updated_by                          Int?
  approved_by                         Int?
  rejected_by                         Int?
  metadata                            String?
  created_at                          DateTime?
  updated_at                          DateTime?
  deleted_at                          DateTime?
  admission_fee                       Decimal               @default(0)
  payment_number                      String?
  transaction_id                      String?
  payment_method                      String?
  payment_status                      String                @default("unpaid")
  paid_at                             DateTime?
  verified_at                         DateTime?
  verified_by                         Int?
  payment_note                        String?
  admission_documents                 admission_documents[]
  admission_tests                     admission_tests[]
  users_admissions_verified_byTousers users?                @relation("admissions_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction)
  academic_sessions                   academic_sessions     @relation(fields: [academic_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batches                             batches               @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_admissions_created_byTousers  users?                @relation("admissions_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_admissions_updated_byTousers  users?                @relation("admissions_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  users_admissions_approved_byTousers users?                @relation("admissions_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction)
  users_admissions_rejected_byTousers users?                @relation("admissions_rejected_byTousers", fields: [rejected_by], references: [id], onUpdate: NoAction)
  students                            students[]

  @@index([transaction_id], map: "admissions_transaction_id_index")
  @@index([payment_status], map: "admissions_payment_status_index")
  @@index([phone], map: "admissions_phone_index")
  @@index([first_name, last_name], map: "admissions_name_search")
  @@index([mother_name], map: "admissions_mother_name_index")
  @@index([father_name], map: "admissions_father_name_index")
  @@index([email], map: "admissions_email_index")
  @@index([application_number, status, email, phone], map: "admissions_application_number_status_email_phone_index")
}

model admit_cards {
  id                Int       @id @default(autoincrement())
  exam_id           Int
  student_id        Int
  admit_card_number String    @unique(map: "admit_cards_admit_card_number_unique")
  issue_date        DateTime
  details           String?
  status            String    @default("issued")
  generated_by      Int?
  created_at        DateTime?
  updated_at        DateTime?
  deleted_at        DateTime?
  users             users?    @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  students          students  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exams             exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_id, student_id], map: "admit_cards_exam_id_student_id_unique")
}

model announcements {
  id             Int                       @id @default(autoincrement())
  title          String
  body           String?
  audience       String                    @default("all")
  is_published   Boolean @default(true)
  starts_at      DateTime?
  ends_at        DateTime?
  created_at     DateTime?
  updated_at     DateTime?
  display_target String                    @default("header")
  title_bn       String?
  body_bn        String?
}

model assignment_submissions {
  id                   Int         @id @default(autoincrement())
  assignment_id        Int
  student_id           Int
  file_path            String?
  notes                String?
  submitted_at         DateTime?
  marks                Int?
  feedback             String?
  graded_by            Int?
  graded_at            DateTime?
  status               String      @default("submitted")
  created_at           DateTime?
  updated_at           DateTime?
  guardian_notes       String?
  guardian_notified_at DateTime?
  guardian_id          Int?
  guardians            guardians?  @relation(fields: [guardian_id], references: [id], onUpdate: NoAction)
  assignments          assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students             students    @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?      @relation(fields: [graded_by], references: [id], onUpdate: NoAction)
}

model assignments {
  id                     Int                       @id @default(autoincrement())
  title                  String
  description            String?
  batch_id               Int
  subject_id             Int
  due_date               DateTime
  total_marks            Int?
  file_path              String?
  created_by             Int
  created_at             DateTime?
  updated_at             DateTime?
  deleted_at             DateTime?
  class_id               Int?
  section_id             Int?
  allow_guardian_notes   Boolean @default(false)
  assignment_submissions assignment_submissions[]
  sections               sections?                 @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  school_classes         school_classes?           @relation(fields: [class_id], references: [id], onUpdate: NoAction)
  batches                batches                   @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects               subjects                  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users                     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model attendances {
  id                                   Int                @id @default(autoincrement())
  student_id                           Int
  school_class_id                      Int
  subject_id                           Int?
  date                                 DateTime
  status                               String?
  marked_by                            Int
  created_at                           DateTime?
  updated_at                           DateTime?
  deleted_at                           DateTime?
  batch_id                             Int?
  section_id                           Int?
  teacher_id                           Int?
  academic_session_id                  Int?
  type                                 String?            @default("daily")
  period                               String?
  remarks                              String?
  recorded_by                          Int?
  updated_by                           Int?
  metadata                             String?
  users_attendances_marked_byTousers   users              @relation("attendances_marked_byTousers", fields: [marked_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects                             subjects?          @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  school_classes                       school_classes     @relation(fields: [school_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students                             students           @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batches                              batches?           @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  sections                             sections?          @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  teachers                             teachers?          @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  academic_sessions                    academic_sessions? @relation(fields: [academic_session_id], references: [id], onUpdate: NoAction)
  users_attendances_recorded_byTousers users?             @relation("attendances_recorded_byTousers", fields: [recorded_by], references: [id], onUpdate: NoAction)
  users_attendances_updated_byTousers  users?             @relation("attendances_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)

  @@unique([student_id, date, type], map: "attendances_unique_per_student_date_type")
}

model audits {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  event          String
  auditable_type String
  auditable_id   Int
  old_values     String?
  new_values     String?
  url            String?
  ip_address     String?
  user_agent     String?
  created_at     DateTime?
  updated_at     DateTime?
  users          users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([auditable_type, auditable_id], map: "audits_auditable_type_auditable_id_index")
}

model batches {
  id                  Int                       @id @default(autoincrement())
  name                String
  code                String?
  description         String?
  start_date          DateTime?
  end_date            DateTime?
  academic_session_id Int?
  is_active           Boolean @default(true)
  status              String?
  notes               String?
  created_at          DateTime?
  updated_at          DateTime?
  deleted_at          DateTime?
  capacity            Int                       @default(30)
  course_id           Int?
  admissions          admissions[]
  assignments         assignments[]
  attendances         attendances[]
  courses             courses?                  @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  academic_sessions   academic_sessions?        @relation(fields: [academic_session_id], references: [id], onUpdate: NoAction)
  exams               exams[]
  routines            routines[]
  students            students[]
}

model book_categories {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  created_at  DateTime?
  updated_at  DateTime?
  books       books[]
}

model book_issues {
  id          Int                       @id @default(autoincrement())
  book_id     Int
  student_id  Int?
  teacher_id  Int?
  issue_date  DateTime
  due_date    DateTime
  return_date DateTime?
  status      String                    @default("issued")
  late_fee    Decimal?
  fine_paid   Boolean @default(false)
  notes       String?
  issued_by   Int?
  created_at  DateTime?
  updated_at  DateTime?
  deleted_at  DateTime?
  users       users?                    @relation(fields: [issued_by], references: [id], onUpdate: NoAction)
  teachers    teachers?                 @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  students    students?                 @relation(fields: [student_id], references: [id], onUpdate: NoAction)
  books       books                     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model books {
  id                 Int                       @id @default(autoincrement())
  title              String
  author             String?
  publisher          String?
  isbn               String?                   @unique(map: "books_isbn_unique")
  category_id        Int?
  shelf_location     String?
  quantity           Int                       @default(1)
  available_quantity Int                       @default(1)
  purchase_date      DateTime?
  price              Decimal?
  description        String?
  cover_image        String?
  status             Boolean @default(true)
  created_by         Int?
  created_at         DateTime?
  updated_at         DateTime?
  deleted_at         DateTime?
  book_issues        book_issues[]
  users              users?                    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  book_categories    book_categories?          @relation(fields: [category_id], references: [id], onUpdate: NoAction)
}

model budgets {
  id                  Int                 @id @default(autoincrement())
  expense_category_id Int?
  period_type         String              @default("monthly")
  period_start        DateTime
  period_end          DateTime
  amount              Decimal
  notes               String?
  created_at          DateTime?
  updated_at          DateTime?
  tenant_id           Int?
  expense_categories  expense_categories? @relation(fields: [expense_category_id], references: [id], onUpdate: NoAction)

  @@index([tenant_id], map: "budgets_tenant_id_index")
}

model cache {
  key        String @id
  value      String
  expiration Int
}

model cache_locks {
  key        String @id
  owner      String
  expiration Int
}

model careers {
  id               Int                       @id @default(autoincrement())
  title            String
  description      String
  requirements     String
  type             String
  location         String
  salary_min       Decimal?
  salary_max       Decimal?
  deadline         DateTime
  is_published     Boolean @default(false)
  created_at       DateTime?
  updated_at       DateTime?
  job_applications job_applications[]
}

model certificates {
  id                                     Int       @id @default(autoincrement())
  name                                   String
  template                               String
  created_by                             Int
  created_at                             DateTime?
  updated_at                             DateTime?
  student_id                             Int?
  certificate_type                       String?
  issue_date                             DateTime?
  certificate_number                     String?   @unique(map: "certificates_certificate_number_unique")
  body                                   String?
  status                                 String    @default("draft")
  generated_by                           Int?
  users_certificates_generated_byTousers users?    @relation("certificates_generated_byTousers", fields: [generated_by], references: [id], onUpdate: NoAction)
  students                               students? @relation(fields: [student_id], references: [id], onUpdate: NoAction)
  users_certificates_created_byTousers   users     @relation("certificates_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chart_of_accounts {
  id                      Int                       @id @default(autoincrement())
  code                    String                    @unique(map: "chart_of_accounts_code_unique")
  name_en                 String
  name_bn                 String?
  type                    String
  parent_id               Int?
  is_active               Boolean @default(true)
  created_at              DateTime?
  updated_at              DateTime?
  chart_of_accounts       chart_of_accounts?        @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_chart_of_accounts chart_of_accounts[]       @relation("chart_of_accountsTochart_of_accounts")
  expenses                expenses[]
  ledger_entries          ledger_entries[]

  @@index([type], map: "chart_of_accounts_type_index")
}

model class_subject_teacher {
  id                  Int                       @id @default(autoincrement())
  teacher_id          Int
  subject_id          Int
  class_id            Int?
  academic_session_id Int?
  is_primary          Boolean @default(false)
  created_at          DateTime?
  updated_at          DateTime?
  academic_sessions   academic_sessions?        @relation(fields: [academic_session_id], references: [id], onUpdate: NoAction)
  school_classes      school_classes?           @relation(fields: [class_id], references: [id], onUpdate: NoAction)
  subjects            subjects                  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers            teachers                  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, subject_id, class_id, academic_session_id], map: "class_subject_teacher_unique")
}

model class_teacher {
  id                  Int                       @id @default(autoincrement())
  teacher_id          Int
  class_id            Int
  is_class_teacher    Boolean @default(false)
  academic_session_id Int?
  created_at          DateTime?
  updated_at          DateTime?
  academic_sessions   academic_sessions?        @relation(fields: [academic_session_id], references: [id], onUpdate: NoAction)
  school_classes      school_classes            @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers            teachers                  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, class_id, academic_session_id], map: "class_teacher_unique")
}

model classes {
  id            Int                       @id @default(autoincrement())
  name          String
  teacher_id    Int
  subject_id    Int
  section_id    Int
  academic_year String
  schedule      String?
  created_at    DateTime?
  updated_at    DateTime?
  deleted_at    DateTime?
  is_active     Boolean @default(true)
  description   String?
  room_number   String?
  max_students  Int                       @default(30)
  schedule_days String?
  start_time    String?
  end_time      String?
  sections      sections                  @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects      subjects                  @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users                     @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grades        grades[]
}

model committee_members {
  id             Int                       @id @default(autoincrement())
  name           String
  name_bn        String?
  designation    String
  designation_bn String?
  photo          String?
  phone          String?
  email          String?
  bio            String?
  bio_bn         String?
  sort_order     Int                       @default(0)
  is_active      Boolean @default(true)
  created_at     DateTime?
  updated_at     DateTime?
}

model contact_submissions {
  id         Int       @id @default(autoincrement())
  type       String    @default("contact")
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  meta       String?
  created_at DateTime?
  updated_at DateTime?
}

model courses {
  id          Int                       @id @default(autoincrement())
  name        String
  code        String                    @unique(map: "courses_code_unique")
  description String?
  is_active   Boolean @default(true)
  created_at  DateTime?
  updated_at  DateTime?
  batches     batches[]
}

model dashboard_favorites {
  id         Int       @id @default(autoincrement())
  user_id    Int
  url        String
  label      String?
  created_at DateTime?
  updated_at DateTime?
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, url], map: "dashboard_favorites_user_id_url_unique")
}

model device_tokens {
  id           Int       @id @default(autoincrement())
  user_id      Int
  token        String
  platform     String?
  device_name  String?
  app_version  String?
  last_used_at DateTime?
  created_at   DateTime?
  updated_at   DateTime?
  deleted_at   DateTime?
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, token], map: "device_tokens_user_id_token_unique")
  @@index([token], map: "device_tokens_token_index")
}

model event_attendees {
  id         Int       @id @default(autoincrement())
  event_id   Int
  user_id    Int
  status     String    @default("registered")
