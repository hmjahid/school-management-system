APP_NAME=Eskoofy
APP_URL=http://127.0.0.1:8051
APP_LOCALE=en
APP_TIMEZONE=Asia/Dhaka
APP_DEBUG=true
ESKOOFY_VARIANT=bd

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eskoofy
DB_USERNAME=root
DB_PASSWORD=

PAYMENT_DEFAULT_GATEWAY=bkash
PAYMENT_CURRENCY=BDT

ESKOOFY_MINISTRY_LINKS=true
ESKOOFY_MINISTRY_BADGE=true

BKASH_TEST_MODE=true
BKASH_API_KEY=
BKASH_API_SECRET=
BKASH_SANDBOX_URL=
BKASH_LIVE_URL=

ROCKET_TEST_MODE=true
ROCKET_API_KEY=
ROCKET_API_SECRET=

NAGAD_TEST_MODE=true
NAGAD_API_KEY=
NAGAD_API_SECRET=

# UddoktaPay (BD aggregator: bKash/Nagad/Rocket/Upay/bank)
UDDOKTAPAY_TEST_MODE=true
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_SANDBOX_URL=https://sandbox.uddoktapay.com/api
UDDOKTAPAY_LIVE_URL=https://pay.uddoktapay.com/api

STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_TEST_MODE=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

PADDLE_TEST_MODE=true
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=

# SMS — bd keeps SMS_DRIVER=log (today's behavior); int sets SMS_DRIVER=twilio /
# SMS_DRIVER=vonage via the build profile. No Composer dependency for twilio/vonage.
SMS_DRIVER=log
SMS_FROM=SchoolMS
SMS_COUNTRY_CODE=1
SMS_QUEUE=false
SMS_LOG_FILE=
SMS_HTTP_TIMEOUT=30
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vonage / Nexmo
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
VONAGE_BRAND=Eskoofy
VONAGE_API_BASE=https://api.nexmo.com
NEXMO_KEY=
NEXMO_SECRET=
NEXMO_FROM_NUMBER=
# TextLocal
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=
TEXTLOCAL_TEST_MODE=false
# Africa's Talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_FROM=
# Push notifications (log = dev/test, firebase = real FCM)
PUSH_DRIVER=log
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

OFFLINE_BANK_NAME=
OFFLINE_ACCOUNT_NAME=
OFFLINE_ACCOUNT_NUMBER=
OFFLINE_ROUTING_NUMBER=
OFFLINE_INSTRUCTIONS=

# --- Cloud backup (dashboard › cloud backup) ---
# APP_KEY encrypts stored provider credentials at rest. Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (leave empty on a throwaway dev install; production MUST set it)
APP_KEY=

CLOUD_BACKUP_PROVIDER=local
CLOUD_BACKUP_FOLDER=eskoofy-backups
CLOUD_BACKUP_AUTO=false
CLOUD_BACKUP_INTERVAL_MINUTES=60
CLOUD_BACKUP_KEEP=7
CLOUD_BACKUP_TIMEOUT=60
CLOUD_BACKUP_CONNECT_TIMEOUT=15

# Google Drive (either OAuth2 refresh token OR service account)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Dropbox (app key + refresh token, or a short-lived access token)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=

# 4shared
FOURSHARED_API_KEY=
FOURSHARED_USERNAME=
FOURSHARED_PASSWORD=

# Amazon S3 (or compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_REGION=us-east-1

# --- Document designs / watermarks (dashboard › document designs) ---
DOCUMENT_WATERMARK_ENABLED=false
DOCUMENT_WATERMARK_TEXT=

# --- International payment gateways (optional; enabled per install) ---
# Runtime credentials live in the payment_gateways table; these are fallbacks.
GPAY_API_KEY=
GPAY_API_SECRET=
GPAY_SANDBOX_URL=
GPAY_LIVE_URL=
GPAY_CURRENCY=USD
APPLEPAY_API_KEY=
APPLEPAY_API_SECRET=
APPLEPAY_SANDBOX_URL=
APPLEPAY_LIVE_URL=
APPLEPAY_CURRENCY=USD
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CURRENCY=NGN
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_CURRENCY=BDT
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_CURRENCY=USD
MOLLIE_API_KEY=
MOLLIE_CURRENCY=EUR
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_CURRENCY=USD
XENDIT_SECRET_KEY=
XENDIT_CURRENCY=IDR
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CURRENCY=EUR
SKRILL_MERCHANT_EMAIL=
SKRILL_SECRET_WORD=
SKRILL_CURRENCY=USD
