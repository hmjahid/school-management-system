APP_NAME=Eskoofy
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_TIMEZONE=Asia/Dhaka
APP_DEBUG=true
ESKOOFY_VARIANT=bd

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eskoofy
DB_USERNAME=root
DB_PASSWORD=

PAYMENT_DEFAULT_GATEWAY=bkash
PAYMENT_CURRENCY=BDT

ESKOOFY_MINISTRY_LINKS=true
ESKOOFY_MINISTRY_BADGE=true

BKASH_TEST_MODE=true
BKASH_API_KEY=
BKASH_API_SECRET=
BKASH_SANDBOX_URL=
BKASH_LIVE_URL=

ROCKET_TEST_MODE=true
ROCKET_API_KEY=
ROCKET_API_SECRET=

NAGAD_TEST_MODE=true
NAGAD_API_KEY=
NAGAD_API_SECRET=

STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_TEST_MODE=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

PADDLE_TEST_MODE=true
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=

# SMS — bd keeps SMS_DRIVER=log (today's behavior); int sets SMS_DRIVER=twilio /
# SMS_DRIVER=vonage via the build profile. No Composer dependency for twilio/vonage.
SMS_DRIVER=log
SMS_FROM=SchoolMS
SMS_COUNTRY_CODE=1
SMS_LOG_FILE=
SMS_HTTP_TIMEOUT=30
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vonage / Nexmo
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
VONAGE_BRAND=Eskoofy

OFFLINE_BANK_NAME=
OFFLINE_ACCOUNT_NAME=
OFFLINE_ACCOUNT_NUMBER=
OFFLINE_ROUTING_NUMBER=
OFFLINE_INSTRUCTIONS=
