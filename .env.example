APP_NAME=SchoolEase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Admin credentials for initial seeding (required in production)
ADMIN_EMAIL=admin@school.com
# ADMIN_PASSWORD=change_me_in_production

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Error alerting — set to a Slack incoming-webhook URL to alert on failures
LOG_SLACK_WEBHOOK_URL=

# Queue failure monitoring window (minutes) for the queue:monitor-failed command
QUEUE_FAILED_SINCE_MINUTES=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Trusted proxy CIDRs (comma-separated). Defaults to '*' in local dev.
# In production set this to your load balancer / CDN ranges.
TRUSTED_PROXIES=*

# Public website (optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_EMBED_URL=
# Fallback contact line in header/footer if Dashboard → Settings is empty
SCHOOL_CONTACT_PHONE=
SCHOOL_CONTACT_EMAIL=
SCHOOL_CONTACT_ADDRESS=

# SMS configuration
SMS_DRIVER=log
SMS_FROM=SchoolMS
SMS_QUEUE=false
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Nexmo / Vonage
NEXMO_KEY=
NEXMO_SECRET=
NEXMO_FROM_NUMBER=
# TextLocal
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=
TEXTLOCAL_TEST_MODE=false
# Africa's Talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_FROM=

# Payment gateway credentials (NEVER commit real values)
BKASH_API_USERNAME=
BKASH_API_PASSWORD=
BKASH_API_KEY=
BKASH_API_SECRET=
BKASH_SANDBOX_URL=https://checkout.sandbox.bka.sh
BKASH_LIVE_URL=https://checkout.bka.sh
BKASH_WEBHOOK_SECRET=

NAGAD_API_USERNAME=
NAGAD_API_PASSWORD=
NAGAD_API_KEY=
NAGAD_API_SECRET=
NAGAD_SANDBOX_URL=https://sandbox.mynagad.com
NAGAD_LIVE_URL=https://api.mynagad.com/api
NAGAD_WEBHOOK_SECRET=

ROCKET_API_USERNAME=
ROCKET_API_PASSWORD=
ROCKET_API_KEY=
ROCKET_API_SECRET=
ROCKET_SANDBOX_URL=https://api.sandbox.rocket.com.bd/api/v1
ROCKET_LIVE_URL=https://api.rocket.com.bd/api/v1

# Offline / bank transfer details shown on receipts (NEVER commit real values)
OFFLINE_ACCOUNT_NAME=
OFFLINE_ACCOUNT_NUMBER=
OFFLINE_BANK_NAME=
OFFLINE_BRANCH_NAME=
OFFLINE_ROUTING_NUMBER=
ROCKET_WEBHOOK_SECRET=

PAYMENT_CURRENCY=BDT
