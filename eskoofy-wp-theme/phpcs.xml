<?xml version="1.0"?>
<ruleset name="Eskoofy Theme">
    <description>PHPCS ruleset for the Eskoofy WordPress theme.</description>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <arg name="colors"/>

    <file>.</file>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>languages/*.pot</exclude-pattern>
    <exclude-pattern>languages/*.po</exclude-pattern>
    <exclude-pattern>languages/*.mo</exclude-pattern>

    <!-- Use WordPress Coding Standards (WordPress-Extra includes theme-relevant rules) -->
    <rule ref="WordPress-Extra"/>

    <!-- PHP compatibility -->
    <config name="testVersion" value="8.0-"/>

    <!-- Prefixes: all functions/classes/hooks use 'eskoofy' -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="eskoofy"/>
            </property>
        </properties>
    </rule>

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax"/>
</ruleset>
