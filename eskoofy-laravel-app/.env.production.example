APP_NAME="Your School Name"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.tld

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: daily channel, 14-day retention
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Database (MySQL in production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_db
DB_USERNAME=school_user
DB_PASSWORD=

# Sessions and cache go to the database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.tld
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail (configure your real provider)
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.tld
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.tld"
MAIL_FROM_NAME="${APP_NAME}"

# Optional integrations
VITE_APP_NAME="${APP_NAME}"

GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_EMBED_URL=

# Contact info used in the public site header/footer (overridable in Dashboard → Settings)
SCHOOL_CONTACT_PHONE="+1 555 123 4567"
SCHOOL_CONTACT_EMAIL="info@yourdomain.tld"
SCHOOL_CONTACT_ADDRESS="123 School Road, Your City"
