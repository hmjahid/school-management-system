APP_NAME=Eskoofy
APP_URL=http://localhost:8001
APP_LOCALE=en
APP_TIMEZONE=UTC
APP_DEBUG=true
ESKOOFY_VARIANT=int
AUTH_TABLE=customers

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eskoofy_website
DB_USERNAME=root
DB_PASSWORD=

# Licensing (international standard: USD, UTC)
LICENSE_CURRENCY=USD
LICENSE_KEY_PREFIX=ESK
LICENSE_KEY_CHUNKS=4
LICENSE_KEY_LENGTH=4
LICENSE_MAX_ACTIVATIONS=3
LICENSE_ACTIVITY_LOG=true

# Optional shared secret for the license API. When set, /api/v1 license
# activate/validate/deactivate requests must send it in the X-Product-Secret
# header (constant-time compare). Leave empty to keep the API open (not
# recommended in production).
LICENSE_PRODUCT_SECRET=

# Payments — manual works today; Paddle will be added later.
GATEWAY_DEFAULT=manual
GATEWAY_CURRENCY=USD

# USD → BDT rate used to derive BDT prices for BD customers at checkout
# (plans store canonical USD). Adjust when the rate moves.
GATEWAY_BDT_RATE=110

# BD local gateways (bKash / Rocket / Nagad) — sandbox first.
BKASH_TEST_MODE=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_LIVE_URL=
ROCKET_TEST_MODE=true
ROCKET_API_USERNAME=
ROCKET_API_PASSWORD=
ROCKET_API_KEY=
NAGAD_TEST_MODE=true
NAGAD_MERCHANT_ID=
NAGAD_API_KEY=
NAGAD_API_SECRET=

# UddoktaPay (BD aggregator: bKash/Nagad/Rocket/Upay/bank). live_url is your
# hosted/self-hosted UddoktaPay domain + /api.
UDDOKTAPAY_TEST_MODE=true
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_SANDBOX_URL=https://sandbox.uddoktapay.com/api
UDDOKTAPAY_LIVE_URL=https://pay.uddoktapay.com/api

# International gateways — sandbox first.
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_TEST_MODE=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PADDLE_TEST_MODE=true
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_WEBHOOK_SECRET=

PADDLE_TEST_MODE=true
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=

# Geo-language detection (both optional; defaults keep behaviour below).
# Bangladeshi IPs/locations default to Bangla, everyone else to English.
GEO_LANG_ENABLED=true
# Optional: URL template for an IP-geo API returning JSON {country: "XX"}.
# Leave empty to disable. Example: https://ipapi.co/{ip}/json/
GEO_IP_API_URL=
# --- Cloud backup (admin › cloud backup) ---
# APP_KEY encrypts stored provider credentials at rest. Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (leave empty on a throwaway dev install; production MUST set it)
APP_KEY=

CLOUD_BACKUP_PROVIDER=local
CLOUD_BACKUP_FOLDER=eskoofy-backups
CLOUD_BACKUP_AUTO=false
CLOUD_BACKUP_INTERVAL_MINUTES=60
CLOUD_BACKUP_KEEP=7

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=

FOURSHARED_API_KEY=
FOURSHARED_USERNAME=
FOURSHARED_PASSWORD=

S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_REGION=us-east-1
